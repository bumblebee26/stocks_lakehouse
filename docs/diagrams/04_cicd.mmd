flowchart TB
    DEV["👩‍💻 <b>1 · Commit and push to dev</b>"]
    subgraph CI["2 · CI: every push and PR · no cloud access"]
        direction LR
        T1["Python<br/>unit tests"]
        T2["Pipeline<br/>wiring check"]
        T3["terraform<br/>fmt"]
        T4["terraform validate<br/>all stacks"]
    end
    PR["🔀 <b>3 · Open pull request</b> dev → main"]
    subgraph PLAN["4 · Plan: on PR · read-only identity stocks-gha-plan"]
        direction LR
        P1["terraform plan<br/>aws"]
        P2["terraform plan<br/>databricks"]
        PC["💬 plans posted<br/>as PR comments"]
        P1 --> PC
        P2 --> PC
    end
    REV{"5 · Plan shows only<br/>the expected changes?"}
    MERGE["✅ <b>6 · Merge</b>"]
    subgraph APPLY["7 · Apply: on merge · environment production · stocks-gha-apply"]
        direction LR
        A1["terraform apply: aws<br/>Lambdas · schedules · IAM · SSM"]
        A2["terraform apply: databricks<br/>pipeline code · job · dashboard"]
        A1 --> A2
    end
    LIVE["🚀 <b>Live</b>"]
    FIX["↩️ Fix on dev and push again<br/><i>the PR updates and re-plans</i>"]

    DEV --> CI --> PR --> PLAN --> REV
    REV -- "yes" --> MERGE --> APPLY --> LIVE
    REV -. "no" .-> FIX

    classDef step fill:#ffffff,stroke:#64748b,color:#0f172a
    classDef ci fill:#eef2ff,stroke:#6366f1,color:#1e1b4b
    classDef plan fill:#fff7ed,stroke:#f59e0b,color:#451a03
    classDef apply fill:#ecfdf5,stroke:#10b981,color:#022c22
    class DEV,PR,MERGE,LIVE,REV step
    classDef fix fill:#fef2f2,stroke:#ef4444,color:#450a0a,stroke-dasharray: 4 3
    class FIX fix
    class T1,T2,T3,T4 ci
    class P1,P2,PC plan
    class A1,A2 apply
