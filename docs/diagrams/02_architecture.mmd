---
config:
  layout: elk
  elk:
    mergeEdges: false
    nodePlacementStrategy: NETWORK_SIMPLEX
---
flowchart TB
    subgraph EXT["External data sources"]
        direction LR
        NSE["<b>NSE archives</b><br/>UDiFF bhavcopy (.csv.zip)<br/>delivery file · F&amp;O list"]
        MAS["<b>Massive API</b><br/>grouped daily, all US tickers"]
        FREDAPI["<b>FRED API</b><br/>14 global series"]
        NSERSS["<b>News RSS feeds</b><br/>NSE filings · Business Standard · RBI · SEBI"]
    end

    subgraph AWS["AWS account · free plan · ap-southeast-2 (Sydney)"]
        direction TB
        SCH["<b>EventBridge Scheduler</b> (Asia/Kolkata)<br/>NSE 19:30 Mon–Fri · Massive 11:00 Tue–Sat · F&amp;O Mon 08:00<br/>FRED 06:00 Tue–Sat · Brief 08:45 Mon–Fri<br/>News every minute 09:00–15:59, every 30 min 08:00–19:30 Mon–Fri"]
        subgraph LAMBDAS["Lambda functions (Python 3.13, arm64)"]
            direction LR
            FNSE["stocks-fetch-nse"]
            FFO["stocks-fetch-nse_fo"]
            FMAS["stocks-fetch-massive"]
            FFRED["stocks-fetch-fred"]
            FNEWS["stocks-fetch-news"]
            SYNC["stocks-sync-volume<br/><i>manual: backfill / repair</i>"]
            PM["stocks-premarket-brief"]
        end
        S3[("<b>S3 landing bucket</b><br/>landing/&lt;source&gt;/date=YYYY-MM-DD/<br/>private · encrypted · versioned")]
        SSM[["<b>SSM Parameter Store</b><br/>API keys · tokens · workspace URL"]]
        subgraph PT["paper-trader · same account (bumblebee26/paper-trader)"]
            direction LR
            GUARD["stocks-trader-guardian<br/><i>15:45 journal + portfolio export<br/>23:30 late export</i>"]
        end
    end

    subgraph DBX["Databricks Free Edition · Unity Catalog: stocks"]
        direction TB
        VOL[("<b>Volume</b><br/>stocks.bronze.landing")]
        NVOL[("<b>News volume</b><br/>stocks.bronze.news")]
        JOB["<b>Jobs</b><br/>market-close: NSE file → market → research<br/>market-morning: 11:15 Tue–Sat → market<br/>market-weekend: Sat 08:00 → market → research<br/>trading: trades file → trading<br/>each then the dashboard summaries"]
        subgraph PIPE["Lakeflow pipelines (serverless, one runs at a time)"]
            direction LR
            BR["<b>stocks-market</b><br/>bronze 8 · silver 12 · gold 13<br/>NSE · US · FRED · news · fundamentals"]
            SI["<b>stocks-research</b><br/>gold 5 (pandas)<br/>scanner · momentum ranks · signal record"]
            GO["<b>stocks-trading</b><br/>bronze 2 · silver 5 · gold 16<br/>journal · portfolio · shadows · models"]
            BR --> SI
            BR --> GO
        end
        WH["<b>SQL warehouse</b>"]
        DASH["<b>Dashboard</b><br/>Stocks lakehouse: India × US"]
    end

    TG["<b>Telegram</b><br/>pre-market brief + technical scanner"]
    SESS["<b>paper-trader session</b><br/>GitHub Actions · Claude Code"]
    FUND["<b>paper-trader fundamentals</b><br/>GitHub Actions · Sat 07:15"]

    subgraph CTRL["Control plane"]
        direction LR
        GH["<b>GitHub</b><br/>dev → PR → main"]
        GHA["<b>GitHub Actions</b><br/>CI checks · plan · apply"]
        TFS[("<b>Terraform state</b><br/>S3, lockfile")]
        GH --> GHA --> TFS
    end

    SCH -- "1 · invoke" --> FNSE & FFO & FMAS & FFRED & FNEWS
    NSE -- "2 · download" --> FNSE & FFO
    MAS -- "2 · download" --> FMAS
    FREDAPI -- "2 · download" --> FFRED
    NSERSS -- "2 · download" --> FNEWS
    FNSE & FFO & FMAS & FFRED & FNEWS -- "3 · raw file" --> S3
    FNSE & FFO & FMAS & FFRED -- "4 · push (Files API)" --> VOL
    FNEWS -- "4 · push (Files API)" --> NVOL
    NVOL -. "read at the next market run" .-> BR
    SYNC -. "reads" .-> S3
    SYNC -. "push missing" .-> VOL
    VOL -- "5 · new NSE or trades file" --> JOB
    JOB -- "6 · run in order" --> PIPE
    PIPE --> WH --> DASH
    SCH -- "7 · invoke" --> PM
    PM -- "8 · SQL Statement API" --> WH
    PM -- "9 · send" --> TG
    GUARD -- "10 · journal + portfolio (Files API)" --> VOL
    SESS -- "11 · SQL (pre-market context)" --> WH
    NVOL -- "12 · latest.jsonl (Files API)" --> SESS
    FUND -- "13 · fundamentals + Nifty 200 (Files API)" --> VOL
    SSM -. "secrets at runtime" .-> LAMBDAS
    GHA -. "terraform apply" .-> AWS
    GHA -. "terraform apply" .-> DBX

    classDef ext fill:#eef2ff,stroke:#6366f1,color:#1e1b4b
    classDef aws fill:#fff7ed,stroke:#f59e0b,color:#451a03
    classDef store fill:#fffbeb,stroke:#d97706,color:#451a03
    classDef dbx fill:#fef2f2,stroke:#ef4444,color:#450a0a
    classDef bronze fill:#f5e6d3,stroke:#b45309,color:#451a03
    classDef silver fill:#eef2f6,stroke:#64748b,color:#0f172a
    classDef gold fill:#fef9c3,stroke:#ca8a04,color:#422006
    classDef out fill:#ecfdf5,stroke:#10b981,color:#022c22
    classDef ctrl fill:#f1f5f9,stroke:#475569,color:#0f172a
    class NSE,MAS,FREDAPI,NSERSS ext
    class SCH,FNSE,FFO,FMAS,FFRED,FNEWS,SYNC,PM aws
    class S3,SSM store
    class VOL,NVOL,JOB,WH dbx
    class BR silver
    class SI,GO gold
    class DASH,TG out
    classDef trader fill:#f5f3ff,stroke:#8b5cf6,color:#2e1065
    class GUARD,SESS,FUND trader
    class GH,GHA,TFS ctrl
